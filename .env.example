# Kassette — repo-root secrets. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# ⚠️ `.env` is gitignored and must stay that way: it carries a funded Coston2 key.
#
# Nothing in this file is needed to run the FRONTEND — `cd web && npm run seed -- --reset`
# and `npm run dev` read only public Coston2 endpoints. See SETUP.md §1.
#
# The variable names are lowercase where the scripts expect them lowercase. That is not a
# style choice: `contracts/hardhat.config.ts` and `scripts/proveChain.ts` read `private_key`
# and `x_api` exactly as spelled here.

# ── Chain ─────────────────────────────────────────────────────────────────────
# A Coston2 wallet with C2FLR from https://faucet.flare.network/coston2
# ~40 C2FLR to deploy everything from scratch; a few tenths to run the proof scripts.
address=0x
private_key=

# ── FCE-A: the post fetcher ───────────────────────────────────────────────────
# twitterapi.io credential. FCE-A fetches posts with it INSIDE the enclave, which is the
# whole reason that fetch cannot be an FDC attestation (a Web2Json request goes on-chain
# headers and all). Also used by `web/scripts/ingest-x.ts`.
#
# Numbered fallbacks are walked in order when one runs out of credit (HTTP 402).
x_api=
# x_api_2=

# ── FCE-B: the extractor ──────────────────────────────────────────────────────
# OpenRouter key — https://openrouter.ai/keys. This is the model pinned in FCE-B's
# attested build. Free tier is 50 model calls per DAY, per account.
OPENROUTER_API=
# OPENROUTER_API_2=

# Optional. Groq is NOT the enclave's model, so anything it classifies is recorded with
# `matchesEnclaveModel: false`. Useful only for bulk local classification.
# Free tier is 100,000 tokens per DAY on a rolling window — roughly 90-115 posts.
# GROQ_API=

# ── Tunnels ───────────────────────────────────────────────────────────────────
# TWO SEPARATE ngrok accounts. The free plan allows one reserved domain each, and each
# enclave's proxy needs its own — the hostname is written on-chain at registration.
#
# ⛔ Never run `ngrok config add-authtoken`. It rewrites ~/.config/ngrok in place, which may
# belong to another project. Both start-tunnel.sh scripts pass --config at their own file
# and read the token from here.
NGROK_AUTHTOKEN=
NGROK_AUTHTOKEN_2=

# ── Flare indexer ─────────────────────────────────────────────────────────────
# Shared hosted account, requested from Flare — has lead time. The ext-proxy needs it.
# ⚠️ `db_url` reads like `https://HOST:3306/indexer` but is a MySQL TCP endpoint, not a URL.
db_url=
database=indexer
username=
password=
